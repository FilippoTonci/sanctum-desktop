# Dev-mode environment variables, for reference.
#
# NOTHING IN THIS REPO LOADS A .env FILE. `npm run dev` sets these inline
# (see package.json) and the main process reads them from process.env.
# Copying this to .env.local has no effect — export them in your shell if
# you launch Electron some other way.

# Enable dev-mode sidecar spawn from a sibling sanctum checkout.
# Read by src/main/paths.ts to choose between the sibling checkout and the
# packaged PyInstaller binary.
ELECTRON_DEV=1

# Path (relative or absolute) to the sanctum repo containing the Python
# backend. Used as the spawn cwd for `sanctum serve`.
SANCTUM_DEV_REPO=../sanctum
