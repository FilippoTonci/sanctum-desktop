# Dev-mode config — copy to .env.local and adjust.
# WS3 wires sidecar spawn to consume these.

# Enable dev-mode sidecar spawn from a sibling sanctum checkout.
ELECTRON_DEV=1

# Path (relative or absolute) to the sanctum repo containing the Python backend.
# Used by the main process to `python -m sanctum.cli serve` instead of spawning
# the packaged PyInstaller binary.
SANCTUM_DEV_REPO=../sanctum
