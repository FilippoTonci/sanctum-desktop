{
  "name": "sanctum-desktop",
  "version": "0.1.0-rc.1",
  "description": "Local-first document anonymization desktop app — Electron shell for the Sanctum engine.",
  "author": {
    "name": "Filippo Tonci",
    "email": "filippo.tonci@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FilippoTonci/sanctum-desktop.git"
  },
  "main": "out/main/index.js",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "ELECTRON_DEV=1 SANCTUM_DEV_REPO=../sanctum PATH=../sanctum/.venv/bin:$PATH electron-vite dev --watch -- --remote-debugging-port=9333",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --build --force",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "VITEST_LANE=unit vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "make": "electron-vite build && electron-builder",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.19",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "docx-preview": "0.3.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "happy-dom": "20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "patch-package": "8.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
